# ── Multiple LLM Providers Configuration ──────────────────────────────
# The app will randomly select an available provider per generation run.
# Leave keys blank to disable a provider.

# 1. Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# 2. Cohere
COHERE_API_KEY=
COHERE_MODEL=command-r-plus-08-2024

# 3. LLM7
LLM7_API_KEY=
LLM7_BASE_URL=https://api.llm7.io/v1
LLM7_MODEL=default

# 4. Nvidia Build
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# 5. OVH Kepler Endpoint
USE_OVH_KEPLER=false
OVH_API_KEY=
OVH_KEPLER_URL=https://qwen-guard-gen-8b.endpoints.kepler.ai.cloud.ovh.net/api/openai_compat/v1

# 6. Local LM Studio Fallback
USE_LOCAL_LM_STUDIO=false
API_KEY=lm-studio
BASE_URL=http://localhost:1234/v1
MODEL_NAME=lmstudio-community/Meta-Llama-3-8B-Instruct-GGUF
